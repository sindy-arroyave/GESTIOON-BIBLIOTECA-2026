<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="BibliotecaDb" providerName="System.Data.SqlClient" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=BibliotecaDB;Integrated Security=True;Connect Timeout=15;TrustServerCertificate=True" />
  </connectionStrings>
</configuration>
